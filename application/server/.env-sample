# Cấu hình database
DB_USER=postgres
DB_PASSWORD=replace_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Dealzy

# Chuỗi JWT_SECRET
JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret
JWT_RESET_SECRET=replace_with_different_long_random_reset_secret

# Cấu hình Gmail/SMTP
EMAIL_USER=your_email@example.com
EMAIL_PASS=replace_me
EMAIL_SEND_TIMEOUT_MS=20000
SPEEDSMS_API_KEY=replace_me
SMS_MOCK_ENABLED=false
FRONTEND_URL=http://localhost:5173

# Cấu hình VNPay Test Sandbox
VNPAY_TMN_CODE=replace_me
VNPAY_HASH_SECRET=replace_me
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/orders/vnpay-return

# Cấu hình MoMo Test Sandbox
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=replace_me
MOMO_SECRET_KEY=replace_me
MOMO_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/api/orders/momo-return
MOMO_IPN_URL=http://localhost:5000/api/orders/momo-ipn

# Cấu hình VietQR chuyển khoản (Có thể sửa thành ngân hàng thật của bạn để quét thử)
BANK_ID=MB
BANK_ACCOUNT_NO=999918059999
BANK_ACCOUNT_NAME=CONG TY DEALZY

# Cấu hình PayPal Test Sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5000/api/orders/paypal-return
# Supabase Postgres. Replace YOUR_PASSWORD with the database password from Supabase Project Settings.
# Remove the leading # on DATABASE_URL when you want the backend to use Supabase instead of local PostgreSQL.
DATABASE_URL=postgresql://user:password@host:6543/database
DB_SSL=true
PENDING_ORDER_EXPIRY_MINUTES=30
PENDING_ORDER_EXPIRY_SCAN_MS=60000
